# Copy this file to .env.production on the VM and adjust all values.

# Public domain that points to the VM.
# Example: dpp.example.com
APP_DOMAIN=your-domain.example.com

# Email address used by Let's Encrypt for certificate notices.
LETSENCRYPT_EMAIL=admin@example.com

# Use a long, random password in production.
# Example generator: openssl rand -base64 32
NEO4J_PASSWORD=change-me-use-a-long-random-password

