            "id": "aas-nameplate-provider-001",
            "name": "AAS Digital Nameplate Provider",
            "provider": "CircThread AAS Adapter (IDTA 02006-2-0)",
            "description": "Reads AAS Digital Nameplate submodels per IDTA 02006-2-0 and maps them to DPP passport fields. Covers Gorenje WNA 94 ARIWIFI washing machine and Maxeon solar panels. Includes CircThread-specific circular economy extensions (repairability, recyclability, take-back).",
            "base_url": "http://aas-nameplate-provider:8023",
            "product_types": [
                "washing_machine",
                "solar_panel"
            ],
            "data_categories": [
                "circular_economy",
                "compliance",
                "identification",
                "technical"
            ],
            "conditions": {
                "requires_auth": false,
                "input_format": "AAS JSON with Submodel idShort Nameplate",
                "submodel_template": "Digital Nameplate for Industrial Equipment (IDTA 02006-2-0)",
                "identifier_pattern": ".+",
                "catalogue": "open: AAS documents can be ingested at runtime via POST /aas/ingest"
            },
            "status": "active"
        },
        {
            "id": "eprel-provider-001",
